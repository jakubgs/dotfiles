#!/usr/bin/env bash

# Script for searching through Git stash using FZF.
# Should work as `git stash-search` if it's in your $PATH.

__fzf_git_stash_search__() {
    git rev-parse --is-inside-work-tree >/dev/null || return
    local format='%<(7)%C(red)%h%Creset %<(9)%C(green)%C(bold)%gD%Creset %C(cyan)%as%Creset %gs %C(yellow)%d%Creset'
    local selected=$(
      git reflog --color=always --pretty=format:"${format}" |
        fzf --ansi --no-sort --reverse \
        --tiebreak=index \
        --preview-window='right:50%' \
        --preview='git show --color=always ${1}' \
        --preview-label ' git show ' \
        --bind 'ctrl-i:transform:
            if [[ $FZF_PREVIEW_LABEL == " git show " ]]; then
              echo "change-preview(git show --stat --color=always \{1})+change-preview-label( git show --stat )"
            else
              echo "change-preview(git show --color=always \{1})+change-preview-label( git show )"
            fi'
    )
    echo "${selected}"
}

# Run only when not being sourced.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    SELECTED=$(__fzf_git_stash_search__ "$@")
    echo "${SELECTED%% *}"
    echo "${SELECTED%% *}" | wl-copy -on
fi
