{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "reasoningEffort": "none",
  "textVerbosity": "low",
  "default_agent": "chat",
  "share": "disabled",
  "mouse": false,
  "autoupdate": false,
  "snapshot": false,
  "agent": {
    "chat": {
      "description": "Pure chat. No tools, files, shell, web, tasks, or skills.",
      "mode": "primary",
      "permission": {
        "*": "deny"
      },
      "prompt": "Answer using only conversation context and model knowledge. Do not access files, shell, web, tools, skills, or subagents."
    },
    "plan": {
      "reasoningEffort": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "todowrite": "allow",
        "task": "deny",
        "skill": "deny",
        "external_directory": "deny"
      }
    },
    "build": {
      "disable": false,
      "reasoningEffort": "medium",
      "permission": {
        "edit": "ask",
        "bash": "deny",
        "todowrite": "allow",
        "task": "deny",
        "skill": "deny",
        "external_directory": "deny"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "deny",
    "todowrite": "allow",
    "task": "deny",
    "skill": "deny",
    "external_directory": "deny",
    "webfetch": "allow",
    "websearch": "allow"
  }
}
